import { useEffect } from 'react';
import { Link } from 'react-router-dom';
import { motion } from 'framer-motion';
import { FaUsers, FaSchool, FaBook, FaGraduationCap } from 'react-icons/fa';
import { GiBookshelf } from 'react-icons/gi';
import { RiTeamLine, RiLeafLine } from 'react-icons/ri';
import 'aos/dist/aos.css';
import AOS from 'aos';

// Types
type StatItem = {
  value: string;
  label: string;
  icon: React.ReactNode;
};

type FeatureItem = {
  name: string;
  description: string;
  icon: React.ReactNode;
  color?: string;
};

// Custom hook for AOS initialization
const useAOS = (): void => {
  useEffect(() => {
    try {
      AOS.init({
        duration: 800,
        once: true,
        easing: 'ease-in-out',
      });
    } catch (e) {
      console.warn('AOS initialization failed', e);
    }
  }, []);
};

// Stats Component
const Stats = (): JSX.Element => {
  const stats: StatItem[] = [
    { value: '500+', label: 'Students Reached', icon: <FaGraduationCap className="h-8 w-8" /> },
    { value: '50+', label: 'Programs', icon: <FaBook className="h-8 w-8" /> },
    { value: '2000+', label: 'Books Distributed', icon: <GiBookshelf className="h-8 w-8" /> },
    { value: '100%', label: 'Community Focused', icon: <RiTeamLine className="h-8 w-8" /> },
  ];

  return (
    <div className="bg-black py-24 sm:py-32">
      <div className="mx-auto max-w-7xl px-6 lg:px-8">
        <div className="mx-auto max-w-2xl lg:max-w-none">
          <div className="text-center">
            <h2 className="text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Our Impact in Numbers
            </h2>
            <p className="mt-4 text-lg leading-8 text-gray-300">
              Making a difference in the lives of children and families in Kasabuni
            </p>
          </div>
          <div className="mt-16 grid grid-cols-1 gap-0.5 overflow-hidden rounded-2xl text-center sm:grid-cols-2 lg:grid-cols-4">
            {stats.map((stat, index) => (
              <motion.div
                key={stat.label}
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.5, delay: index * 0.1 }}
                className="flex flex-col bg-gray-900 p-8"
              >
                <dt className="text-sm font-semibold leading-6 text-gray-300">{stat.label}</dt>
                <dd className="order-first text-3xl font-semibold tracking-tight text-white">
                  {stat.value}
                </dd>
                <div className="mx-auto mt-4">
                  {stat.icon}
                </div>
              </motion.div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};

// Features Component
const Features = (): JSX.Element => {
  const features: FeatureItem[] = [
    {
      name: 'Education',
      description: 'Providing quality education to underprivileged children',
      icon: <FaBook className="h-6 w-6" />,
      color: 'bg-blue-100 text-blue-600',
    },
    {
      name: 'Community',
      description: 'Building strong community support systems',
      icon: <FaUsers className="h-6 w-6" />,
      color: 'bg-purple-100 text-purple-600',
    },
    {
      name: 'Infrastructure',
      description: 'Improving school facilities and learning environments',
      icon: <FaSchool className="h-6 w-6" />,
      color: 'bg-green-100 text-green-600',
    },
    {
      name: 'Empowerment',
      description: 'Empowering the next generation through education',
      icon: <RiLeafLine className="h-6 w-6" />,
      color: 'bg-yellow-100 text-yellow-600',
    },
  ];

  return (
    <section className="py-24 sm:py-32 bg-white">
      <div className="mx-auto max-w-7xl px-6 lg:px-8">
        <div className="mx-auto max-w-2xl lg:text-center">
          <h2 className="text-base font-semibold leading-7 text-indigo-600">Our Programs</h2>
          <p className="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            Making a difference in Kasabuni
          </p>
        </div>
        <div className="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl">
          <dl className="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2 lg:gap-y-16">
            {features.map((feature, index) => (
              <motion.div
                key={feature.name}
                initial={{ opacity: 0, x: -20 }}
                whileInView={{ opacity: 1, x: 0 }}
                transition={{ duration: 0.5, delay: index * 0.1 }}
                viewport={{ once: true }}
                className="relative pl-16"
              >
                <dt className="text-base font-semibold leading-7 text-gray-900">
                  <div className={`absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg ${feature.color}`}>
                    {feature.icon}
                  </div>
                  {feature.name}
                </dt>
                <dd className="mt-2 text-base leading-7 text-gray-600">{feature.description}</dd>
              </motion.div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  );
};

// CTA Component
const CTA = (): JSX.Element => (
  <section className="relative isolate overflow-hidden bg-indigo-700 py-24 text-center sm:py-32">
    <div className="absolute inset-0 -z-10 bg-[radial-gradient(45rem_50rem_at_top,theme(colors.indigo.100),white)] opacity-20" />
    <div className="absolute inset-y-0 right-1/2 -z-10 mr-16 w-[200%] origin-bottom-left skew-x-[-30deg] bg-white shadow-xl shadow-indigo-600/10 ring-1 ring-indigo-50 sm:mr-28 lg:mr-0 xl:mr-16 xl:origin-center" />
    <div className="mx-auto max-w-2xl px-6 lg:px-8">
      <h2 className="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Join us in making a difference
      </h2>
      <p className="mx-auto mt-6 max-w-xl text-lg leading-8 text-indigo-200">
        Your support helps us continue our mission to provide education and opportunities to children in Kasabuni.
      </p>
      <div className="mt-10 flex items-center justify-center gap-x-6">
        <Link
          to="/donate"
          className="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-indigo-600 shadow-sm hover:bg-indigo-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Donate Now
        </Link>
        <Link to="/about" className="text-sm font-semibold leading-6 text-white">
          Learn more <span aria-hidden="true">→</span>
        </Link>
      </div>
    </div>
  </section>
);

// Main Home Component
const Home = (): JSX.Element => {
  // Initialize AOS
  useAOS();

  return (
    <div className="bg-white">
      {/* Hero Section */}
      <section className="relative isolate px-6 pt-14 lg:px-8">
        <div className="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
          <div
            className="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"
            style={{
              clipPath:
                'polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)',
            }}
          />
        </div>
        <div className="mx-auto max-w-3xl py-32 sm:py-48 lg:py-56">
          <div className="text-center">
            <h1 className="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">
              Empowering Communities Through Education
            </h1>
            <p className="mt-6 text-lg leading-8 text-gray-600">
              We're dedicated to providing quality education and resources to underprivileged children in Kasabuni, Kenya.
              Join us in making a lasting impact.
            </p>
            <div className="mt-10 flex items-center justify-center gap-x-6">
              <Link
                to="/donate"
                className="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
              >
                Donate Now
              </Link>
              <Link to="/about" className="text-sm font-semibold leading-6 text-gray-900">
                Learn more <span aria-hidden="true">→</span>
              </Link>
            </div>
          </div>
        </div>
      </section>

      {/* Stats Section */}
      <Stats />

      {/* Features Section */}
      <Features />

      {/* CTA Section */}
      <CTA />
    </div>
  );
};

export default Home;
