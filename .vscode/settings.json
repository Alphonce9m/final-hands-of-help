// Minimal VS Code settings for Tailwind CSS
{
  "files.associations": {
    "*.css": "postcss"
  },
  "tailwindCSS.includeLanguages": {
    "plaintext": "html"
  },
  "editor.quickSuggestions": {
    "strings": true
  },
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "css.lint.unknownAtRules": "ignore"
}
